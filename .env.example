# API-Football CMS proxy (primary source for matches/standings/topscorers).
# The proxy stores the API-Football key on the backend, so this app sends
# no auth header. Defaults to https://api.labenditaec.com/api/football when unset.
FOOTBALL_API_BASE_URL=
# Default season passed to API-Football endpoints (year of season start).
FOOTBALL_API_SEASON=2025

# Football-Data.org API token (optional fallback for La Liga data when the
# CMS proxy is unreachable). Free tier — register at:
# https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# Site URL (used for SEO, sitemap, OpenGraph, SSR API self-calls)
NEXT_PUBLIC_SITE_URL=https://banthangvn.com

# --- AWS Amplify (set in Amplify Console → Environment variables) ---
# Platform must be WEB_COMPUTE (Next.js SSR). Amplify auto-sets AWS_APP_ID and AWS_BRANCH.
# After adding a custom domain, set NEXT_PUBLIC_SITE_URL to your production URL.
# Optional: FOOTBALL_DATA_TOKEN, FOOTBALL_API_BASE_URL, FOOTBALL_API_SEASON

# --- banthangvn.com CMS integration ---
# Base URL for the headless CMS API (ai-articles endpoints).
# Defaults to http://localhost:4000/api when unset.
NEXT_PUBLIC_CMS_API_URL=https://<your-cms-host>/api
